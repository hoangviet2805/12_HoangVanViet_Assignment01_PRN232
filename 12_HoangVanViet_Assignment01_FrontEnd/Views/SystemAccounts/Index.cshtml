@model IEnumerable<_12_HoangVanViet_Assignment01_FrontEnd.Models.SystemAccount>

@{
    ViewData["Title"] = "Manage Accounts";
}

<h2>Manage System Accounts</h2>
<p>
    Welcome to the Account Management page! 
    This page is restricted to Admins.
</p>

<table class="table table-striped table-hover mt-4">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var account in Model)
            {
                <tr>
                    <td>@account.AccountID</td>
                    <td>@account.AccountName</td>
                    <td>@account.AccountEmail</td>
                    <td>
                        @switch (account.AccountRole)
                        {
                            case 0:
                                <span class="badge bg-danger">Admin</span>
                                break;
                            case 1:
                                <span class="badge bg-primary">Staff</span>
                                break;
                            case 2:
                                <span class="badge bg-secondary">Lecturer</span>
                                break;
                            default:
                                <span class="badge bg-light text-dark">Unknown</span>
                                break;
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">No accounts found.</td>
            </tr>
        }
    </tbody>
</table>
